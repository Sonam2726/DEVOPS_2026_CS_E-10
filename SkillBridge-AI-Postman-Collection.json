              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewedUser\": \"{{userId}}\",\n  \"rating\": 4,\n  \"comment\": \"Postman review test\"\n}"
            },
            "url": "{{baseUrl}}/api/reviews"
          }
        }
      ]
    },
